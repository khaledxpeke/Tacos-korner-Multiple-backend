<!DOCTYPE html>
<html lang="{{language}}" dir="{{dir}}">
<head>
  <meta charset="utf-8">
  <style>
    * { box-sizing: border-box; }
    body {
      width: 80mm;
      margin: 0;
      padding: 4mm;
      font-family: Arial, sans-serif;
      font-size: 11px;
      color: #111;
    }
    h1, p { margin: 0; }
    h1 { font-size: 14px; }
    .address { white-space: pre-line; margin-top: 1mm; }
    .band, .name {
      background: #111;
      color: #fff;
      margin-top: 2mm;
      padding: 2mm;
      font-weight: 700;
    }
    .band { display: flex; justify-content: space-between; align-items: center; gap: 2mm; }
    .num { font-size: 16px; }
    .name { font-size: 18px; }
    .meta { margin-top: 2mm; }
    table { width: 100%; border-collapse: collapse; margin-top: 2mm; }
    td { vertical-align: top; padding: 0.4mm 0; }
    .price { text-align: end; white-space: nowrap; padding-inline-start: 2mm; }
    .indent { padding-inline-start: 3mm; }
    .sep { border-top: 1px dashed #111; margin: 2mm 0; }
    .strong { border-top: 1px solid #111; }
    .total td { font-size: 14px; font-weight: 800; padding-top: 1mm; }
    .thanks, .powered { text-align: center; margin-top: 3mm; }
    .qr { display: block; width: 28mm; height: 28mm; margin: 2mm auto 0; }
  </style>
</head>
<body>
  <h1>{{restaurantName}}</h1>
  <p class="address">{{address}}</p>
  <div class="band">
    <span class="num">#{{commandNumber}}</span>
    <span>{{pack}}</span>
  </div>
  <div class="name">{{customerName}}</div>
  <p class="meta">{{boughtAt}}</p>
  <p class="meta"><strong>{{paymentMethod}}</strong></p>
  <table>
    <tr>
      <td><strong>{{productLabel}}</strong></td>
      <td class="price"><strong>{{priceLabel}}</strong></td>
    </tr>
  </table>
  <div class="sep"></div>
  {{#each products}}
    <table>
      <tr>
        <td><strong>{{name}}</strong></td>
        <td class="price">{{price}}</td>
      </tr>
      {{#if variation}}
        <tr>
          <td class="indent">{{variation.name}}</td>
          <td class="price">{{variation.price}}</td>
        </tr>
      {{/if}}
      {{#each addons}}
        <tr>
          <td class="indent">{{name}}</td>
          <td class="price">{{price}}</td>
        </tr>
      {{/each}}
      {{#if showExtras}}
        <tr>
          <td colspan="2"><strong>{{../extrasLabel}}</strong></td>
        </tr>
        {{#each extras}}
          <tr>
            <td class="indent">{{name}}</td>
            <td class="price">{{price}}</td>
          </tr>
        {{/each}}
      {{/if}}
    </table>
    {{#unless @last}}<div class="sep"></div>{{/unless}}
  {{/each}}
  <div class="sep strong"></div>
  <table>
    <tr>
      <td>{{tvaLabel}}</td>
      <td class="price">{{tvaAmount}}</td>
    </tr>
    <tr>
      <td>{{htLabel}}</td>
      <td class="price">{{ht}}</td>
    </tr>
  </table>
  {{#if showReductions}}
    <table>
      <tr>
        <td>{{subtotalLabel}}</td>
        <td class="price">{{subtotal}}</td>
      </tr>
      {{#if discount}}
        <tr>
          <td>{{discountLabel}}</td>
          <td class="price">{{discount}}</td>
        </tr>
      {{/if}}
      {{#if loyalty}}
        <tr>
          <td>{{loyaltyLabel}}</td>
          <td class="price">{{loyalty}}</td>
        </tr>
      {{/if}}
    </table>
  {{/if}}
  <div class="sep strong"></div>
  <table class="total">
    <tr>
      <td>{{totalLabel}}</td>
      <td class="price">{{total}} {{currency}}</td>
    </tr>
  </table>
  <p class="thanks">{{thankYou}}</p>
  <p class="thanks">{{seeYou}}</p>
  {{#if qr}}<img class="qr" src="{{qr}}" alt="">{{/if}}
  <p class="powered"><strong>Powered by LayaFood</strong></p>
</body>
</html>
